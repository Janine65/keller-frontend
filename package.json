{
  "name": "keller-frontend",
  "displayName": "Keller Organisator",
  "description": "Keller Organisator: angular, typescript, rxjs, primeng",
  "version": "2.0.4",
  "license": "MIT",
  "author": {
    "name": "Janine Franken",
    "email": "janine@olconet.com"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "nx serve",
    "build": "nx build",
    "postbuild": "cp -f ./package.json dist",
    "postversion": "git push && git push --tags && pnpm docker:dev && pnpm docker:dev:run",
    "docker": "nx build && docker-compose build --no-cache && docker-compose push",
    "docker:readme": "sh -c 'docker pushrm janine65/keller-backend --file ../keller-backend/README.docker.md && docker pushrm janine65/keller-frontend --file README.docker.md'",
    "docker:dev": "nx build && sh -c 'docker compose -f docker-compose-test.yml build --no-cache'",
    "docker:dev:run": "sh -c 'docker compose -f docker-compose-test.yml down && docker compose -f docker-compose-test.yml up -d'",
    "app:build": "nx build --configuration=app && cap sync ios",
    "app:open": "cap open ios"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "22.1.9",
    "@angular/animations": "22.1.8",
    "@angular/cdk": "22.1.8",
    "@angular/cli": "22.1.9",
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/material": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/platform-browser-dynamic": "22.1.8",
    "@angular/router": "22.1.8",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-brands-svg-icons": "^6.5.2",
    "@fortawesome/free-regular-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@primeuix/themes": "^3.0.1",
    "flag-icons": "7.2.1",
    "ngx-cookie": "6.0.1",
    "ngx-cookie-service": "^22.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^22.1.2",
    "rxjs": "~7.8.1",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "2.6.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.9",
    "@angular-devkit/schematics": "22.1.9",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "22.1.9",
    "@angular/compiler-cli": "22.1.8",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "22.1.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^29.5.0",
    "@types/node": "20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@typescript-eslint/utils": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "8.10.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.1",
    "nx": "23.2.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-jest": "29.1.2",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}

{
  "name": "keller-frontend",
  "displayName": "Keller Organisator",
  "description": "Keller Organisator: angular, typescript, rxjs, primeng",
  "version": "1.0.15",
  "license": "MIT",
  "author": {
    "name": "Janine Franken",
    "email": "janine@olconet.com"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "nx serve",
    "build": "nx build",
    "postbuild": "cp -f ./package.json dist",
    "postversion": "git push && git push --tags",
    "docker": "nx build && docker-compose build --no-cache && docker-compose push",
    "app:build": "nx build --configuration=app && cap sync ios",
    "app:open": "cap open ios"
  },
  "private": true,
